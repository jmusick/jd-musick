---
import { Icon } from "astro-icon/components";
import { ACTIVE_SOCIALS, SITE_NAME } from "../config/site";

interface Props {
	active?: "home" | "music" | "about" | "contact";
}

const { active = "home" } = Astro.props;
---

<script is:inline>
	// Marks that JavaScript is available so CSS may collapse the mobile menu.
	// Without JS the menu stays expanded and fully usable.
	document.documentElement.classList.add("js");
</script>

<header class="site-head">
	<div class="site-head-inner">
		<a href="/" class="brand-link" aria-label={`${SITE_NAME} — home`}>
			<span class="brand-wordmark">JD MUSICK</span>
		</a>

		<button
			type="button"
			class="nav-toggle"
			aria-expanded="false"
			aria-controls="site-menu"
			aria-label="Toggle menu"
		>
			<Icon name="lucide:menu" class="nav-toggle-icon-open" aria-hidden="true" />
			<Icon name="lucide:x" class="nav-toggle-icon-close" aria-hidden="true" />
		</button>

		<div class="site-head-right" id="site-menu">
			<nav class="site-nav" aria-label="Primary">
				<a class={active === "home" ? "active" : undefined} href="/">Home</a>
				<a class={active === "music" ? "active" : undefined} href="/music/">Music</a>
				<a class={active === "about" ? "active" : undefined} href="/about/">About</a>
				<a class={active === "contact" ? "active" : undefined} href="/contact/">Contact</a>
			</nav>

			{ACTIVE_SOCIALS.length > 0 && (
				<>
					<div class="site-head-divider" aria-hidden="true"></div>
					<nav class="social-nav" aria-label="Social media">
						{ACTIVE_SOCIALS.map((s) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.label}
								class="social-link"
							>
								<Icon name={s.icon} aria-hidden="true" />
							</a>
						))}
					</nav>
				</>
			)}
		</div>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
	const menu = document.getElementById("site-menu");

	if (toggle && menu) {
		// Must match the max-width breakpoint in public/universal.css.
		const mobile = window.matchMedia("(max-width: 900px)");

		// Keep the menu inert while it is collapsed on small screens so its links
		// leave the tab order immediately (CSS visibility:hidden follows the fade).
		// Never leave it inert on desktop, where the menu is always visible.
		const sync = () => {
			menu.inert = mobile.matches && !menu.classList.contains("is-open");
		};

		const setOpen = (open: boolean, restoreFocus = true) => {
			const hadFocus = restoreFocus && !open && menu.contains(document.activeElement);
			menu.classList.toggle("is-open", open);
			toggle.classList.toggle("is-open", open);
			toggle.setAttribute("aria-expanded", String(open));
			sync();
			if (hadFocus) toggle.focus();
		};

		toggle.addEventListener("click", () => {
			setOpen(!menu.classList.contains("is-open"));
		});

		menu.addEventListener("click", (event) => {
			if (event.target instanceof HTMLElement && event.target.closest("a")) {
				setOpen(false);
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key !== "Escape" || !menu.classList.contains("is-open")) return;
			if (!mobile.matches) return;
			setOpen(false);
		});

		// Crossing the breakpoint (either way) resets to a clean closed state.
		// The toggle is hidden on desktop, so there is nothing to return focus to.
		mobile.addEventListener("change", () => setOpen(false, false));

		sync();
	}
</script>
