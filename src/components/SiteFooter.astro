---
import { SITE_NAME, SITE_VERSION } from "../config/site";
import SocialIcons from "./SocialIcons.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<span class="footer-mark">{SITE_NAME}</span>

	<SocialIcons />

	<div class="footer-legal">
		<span>© {year} {SITE_NAME} · v{SITE_VERSION} · <a href="/privacy-policy/">Privacy Policy</a></span>
		<span class="footer-credit">Site design by <a href="https://stonedragonmedia.com/" target="_blank" rel="noopener noreferrer">Stone Dragon Media, LLC</a></span>
	</div>
</footer>
