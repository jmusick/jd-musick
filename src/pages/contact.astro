---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import {
	ACTIVE_SOCIALS,
	CONTACT_EMAIL,
	SITE_NAME,
	SITE_URL,
	TURNSTILE_SITE_KEY,
} from "../config/site";

const canonicalUrl = `${SITE_URL}/contact/`;
const description = `Contact ${SITE_NAME} for booking, press, licensing, collaborations, and general enquiries.`;

/** Cloudflare's documented always-passes key keeps the form usable on localhost. */
const TURNSTILE_DEV_TEST_KEY = "1x00000000000000000000AA";
const turnstileSiteKey = import.meta.env.DEV ? TURNSTILE_DEV_TEST_KEY : TURNSTILE_SITE_KEY;

/** Astro's dev server does not serve Cloudflare Pages Functions. */
const functionUnavailable = import.meta.env.DEV;
---

<Layout
	title={`Contact — ${SITE_NAME}`}
	description={description}
	canonicalUrl={canonicalUrl}
	active="contact"
>
	<div class="page contact-page">
		<p class="eyebrow">Contact</p>
		<h1 style="margin-top: var(--space-3)">Get in touch</h1>
		<p class="lede contact-intro">
			For bookings, press, licensing, collaborations, and general enquiries, send a
			message below.
		</p>

		{!turnstileSiteKey && (
			<div class="panel contact-fallback">
				<p>The contact form is temporarily unavailable. You can still reach us at:</p>
				<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
			</div>
		)}

		{turnstileSiteKey && (
			<form class="contact-form panel" id="contact-form" novalidate>
				<div class="field">
					<label for="cf-name">Name</label>
					<input id="cf-name" name="name" type="text" maxlength="100" required autocomplete="name" />
				</div>

				<div class="field">
					<label for="cf-email">Email</label>
					<input id="cf-email" name="email" type="email" maxlength="254" required autocomplete="email" />
					<span class="field-hint">Used only to reply to your message.</span>
				</div>

				<div class="field">
					<label for="cf-subject">Subject <span class="optional">optional</span></label>
					<input id="cf-subject" name="subject" type="text" maxlength="150" />
				</div>

				<div class="field">
					<label for="cf-message">Message</label>
					<textarea id="cf-message" name="message" rows="8" minlength="10" maxlength="4000" required
					></textarea>
				</div>

				{/* Honeypot: hidden from people and assistive technology. */}
				<div class="honeypot" aria-hidden="true">
					<label for="cf-website">Leave this field empty</label>
					<input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
				</div>

				<div
					class="cf-turnstile"
					data-sitekey={turnstileSiteKey}
					data-action="contact"
					data-theme="dark"
					data-appearance="interaction-only"
				>
				</div>

				<div class="form-actions">
					<button type="submit" class="btn btn-primary" id="cf-submit">Send message</button>
					<p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
				</div>

				<p class="form-privacy">
					By sending this form, you agree to the handling described in the
					<a href="/privacy-policy/">Privacy Policy</a>.
				</p>

				{functionUnavailable && (
					<p class="dev-note">
						<strong>Development mode:</strong> Turnstile uses its test key here, but
						<code>astro dev</code> does not serve <code>/api/contact</code>. Build the site,
						then use <code>npx wrangler pages dev dist</code> to test submission.
					</p>
				)}
			</form>
		)}

		{ACTIVE_SOCIALS.length > 0 && (
			<section class="section contact-socials">
				<p class="eyebrow">Elsewhere</p>
				<h2 style="margin-top: var(--space-3)">Listen and follow</h2>
				<nav class="social-nav" aria-label="Social media">
					{ACTIVE_SOCIALS.map((social) => (
						<a
							href={social.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={social.label}
							class="social-link"
						>
							<Icon name={social.icon} aria-hidden="true" />
						</a>
					))}
				</nav>
			</section>
		)}
	</div>

	{turnstileSiteKey && (
		<script
			slot="head"
			is:inline
			src="https://challenges.cloudflare.com/turnstile/v0/api.js"
			async
			defer></script>
	)}
</Layout>

{turnstileSiteKey && (
	<script>
		const form = document.getElementById("contact-form") as HTMLFormElement | null;
		const status = document.getElementById("cf-status");
		const submit = document.getElementById("cf-submit") as HTMLButtonElement | null;

		/**
		 * Longer than the Function's own deadlines (10 s Siteverify + 10 s Email
		 * Sending), so a server-side timeout normally arrives first.
		 */
		const REQUEST_DEADLINE_MS = 25_000;

		if (form && status && submit) {
			let pendingStatus: number | undefined;
			const setStatus = (text: string, state: "" | "ok" | "error") => {
				// Clear first so repeating the same message is announced again.
				window.clearTimeout(pendingStatus);
				status.textContent = "";
				status.dataset.state = state;
				pendingStatus = window.setTimeout(() => {
					status.textContent = text;
				}, 50);
			};

			form.addEventListener("submit", async (event) => {
				event.preventDefault();

				if (!form.checkValidity()) {
					form.reportValidity();
					return;
				}

				const data = new FormData(form);
				const captchaToken = String(data.get("cf-turnstile-response") ?? "");
				if (!captchaToken) {
					setStatus("Please wait for the verification check, then try again.", "error");
					return;
				}

				submit.disabled = true;
				setStatus("Sending…", "");

				const controller = new AbortController();
				const deadline = window.setTimeout(() => controller.abort(), REQUEST_DEADLINE_MS);

				try {
					const response = await fetch("/api/contact", {
						method: "POST",
						signal: controller.signal,
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							name: data.get("name"),
							email: data.get("email"),
							subject: data.get("subject"),
							message: data.get("message"),
							website: data.get("website"),
							captchaToken,
						}),
					});

					const result = (await response.json().catch(() => null)) as
						| { message?: string; error?: string }
						| null;

					if (!response.ok) {
						const fallback =
							response.status === 429
								? "Too many attempts. Please wait a minute and try again."
								: "Something went wrong. Please try again.";
						setStatus(result?.error ?? fallback, "error");
						window.turnstile?.reset();
						return;
					}

					form.reset();
					window.turnstile?.reset();
					setStatus(result?.message ?? "Thanks — your message has been sent.", "ok");
				} catch {
					// Keep the form contents so the visitor can retry. A timed-out request
					// may still have been delivered, so say so rather than resending.
					setStatus(
						controller.signal.aborted
							? "The server took too long to respond, so your message may not have been sent. Please wait a moment and try again."
							: "Could not reach the server. Please try again in a moment.",
						"error",
					);
					window.turnstile?.reset();
				} finally {
					window.clearTimeout(deadline);
					submit.disabled = false;
				}
			});
		}
	</script>
)}

<style>
	.contact-page {
		max-width: 820px;
	}

	.contact-intro {
		margin-top: var(--space-5);
	}

	.contact-form,
	.contact-fallback {
		margin-top: var(--space-7);
	}

	.contact-form {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-5);
		box-shadow: 0 0 44px rgba(174, 0, 248, 0.09), var(--shadow-card);
	}

	.contact-form::before {
		content: "";
		position: absolute;
		inset: 0 24px auto;
		height: 1px;
		background: var(--gradient-neon);
		opacity: 0.75;
	}

	.contact-fallback {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		font-size: var(--text-body-lg);
	}

	.field {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.field label {
		font-weight: 700;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--ink-1);
	}

	.optional,
	.field-hint,
	.form-privacy,
	.dev-note {
		font-size: var(--text-body-sm);
		color: var(--ink-3);
	}

	.optional {
		margin-left: var(--space-2);
		font-size: var(--text-micro);
		font-weight: 500;
	}

	.field input,
	.field textarea {
		width: 100%;
		border: 1px solid var(--border-hairline);
		border-radius: var(--radius-sm);
		background: var(--void-2);
		color: var(--ink-1);
		font: inherit;
		font-size: var(--text-body-lg);
		padding: var(--space-3) var(--space-4);
		transition: border-color var(--duration-base) var(--ease-out),
			box-shadow var(--duration-base) var(--ease-out);
	}

	.field textarea {
		min-height: 180px;
		line-height: var(--lh-body);
		resize: vertical;
	}

	.field input:focus-visible,
	.field textarea:focus-visible {
		outline: none;
		border-color: var(--cyan);
		box-shadow: 0 0 0 2px rgba(34, 211, 247, 0.18), var(--glow-blue);
	}

	.honeypot {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.form-actions {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		flex-wrap: wrap;
	}

	.form-status {
		margin: 0;
		font-size: var(--text-body-sm);
		color: var(--ink-2);
	}

	.form-status[data-state="ok"] {
		color: var(--success);
	}

	.form-status[data-state="error"] {
		color: var(--error);
	}

	button:disabled {
		cursor: not-allowed;
		opacity: 0.5;
		box-shadow: none;
	}

	.form-privacy,
	.dev-note {
		line-height: var(--lh-body);
	}

	.dev-note {
		border-left: 2px solid var(--violet);
		padding-left: var(--space-3);
	}

	.dev-note code {
		color: var(--ink-2);
	}

	.contact-socials .social-nav {
		justify-content: flex-start;
		margin-top: var(--space-4);
	}

	@media (max-width: 480px) {
		.form-actions,
		.form-actions .btn {
			width: 100%;
		}
	}
</style>
