---
import Layout from "../layouts/Layout.astro";
import { ALBUM, TRACK_COUNT } from "../data/album";
import { ACTIVE_SOCIALS, SITE_NAME, SITE_URL } from "../config/site";
import { albumRef, artistEntity } from "../lib/structured-data";

const canonicalUrl = `${SITE_URL}/about/`;

/**
 * Placeholder bio — written in third person per the design system's voice
 * guidance, but not approved copy. Replace before launch.
 */
const bio = [
	`${SITE_NAME} makes smoky electric blues and soul for late nights and quiet rooms.`,
	`In the songs, a man holds onto a matchbook, a bar nears last call, and a pair of Sunday shoes cannot hide what happened at home. Guitar and Hammond organ back a weathered voice.`,
	`The debut album, ${ALBUM.title}, has ${TRACK_COUNT} songs about regret, self-reckoning, reassurance, and finding love after you have stopped expecting it.`,
];

const structuredData = { ...artistEntity(bio[0]), album: albumRef };
---

<Layout
	title={`About — ${SITE_NAME}`}
	description={bio[0]}
	canonicalUrl={canonicalUrl}
	structuredData={structuredData}
	active="about"
>
	<div class="page">
		<p class="eyebrow">About</p>
		<h1 style="margin-top: var(--space-3)">{SITE_NAME}</h1>

		<div
			class="panel"
			style="margin-top: var(--space-7); display: flex; flex-direction: column; gap: var(--space-5)"
		>
			{bio.map((paragraph) => <p class="lede">{paragraph}</p>)}
		</div>

		<hr class="rule" />

		<section>
			<p class="eyebrow">Contact</p>
			<h2 style="margin-top: var(--space-3)">Bookings, press, and licensing</h2>
			<p class="lede" style="margin-top: var(--space-4)">
				Use the contact form for booking, press, licensing, collaborations, or other
				inquiries.
			</p>
			<div class="hero-cta">
				<a class="btn btn-secondary" href="/contact/">Get in touch</a>
			</div>
		</section>

		{ACTIVE_SOCIALS.length > 0 && (
			<section class="section">
				<p class="eyebrow">Elsewhere</p>
				<div class="hero-cta" style="margin-top: var(--space-4)">
					{ACTIVE_SOCIALS.map((s) => (
						<a class="btn btn-ghost" href={s.href} target="_blank" rel="noopener noreferrer">
							{s.label}
						</a>
					))}
				</div>
			</section>
		)}
	</div>
</Layout>
