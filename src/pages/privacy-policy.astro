---
import Layout from "../layouts/Layout.astro";
import { CONTACT_EMAIL, SITE_NAME, SITE_URL } from "../config/site";

const canonicalUrl = `${SITE_URL}/privacy-policy/`;
const lastUpdated = "October 12, 2026";
---

<Layout
	title={`Privacy Policy — ${SITE_NAME}`}
	description={`Privacy Policy for the ${SITE_NAME} website.`}
	canonicalUrl={canonicalUrl}
>
	<div class="page">
		<p class="eyebrow">Legal</p>
		<h1 style="margin-top: var(--space-3)">Privacy Policy</h1>
		<p style="margin-top: var(--space-2); color: var(--ink-3)">
			Last updated: {lastUpdated}
		</p>

		<div class="panel policy" style="margin-top: var(--space-7)">
			<section class="policy-block">
				<h2>Overview</h2>
				<p class="lede">
					This website (<strong>{SITE_URL.replace("https://", "")}</strong>) is a static
					site for {SITE_NAME}. It has no user accounts, advertising, or mailing list. It
					has one contact form and sets no tracking cookies of its own. This policy covers
					what happens when you visit, including the third-party services the site uses,
					links to, or embeds.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Information We Collect</h2>
				<p class="lede">
					The site collects only what you choose to submit through the contact form: your
					name, email address, optional subject, and message. That information is used to
					receive and respond to your enquiry. It is not added to a mailing list, sold, or
					stored in a website database.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Contact Form</h2>
				<p class="lede">
					When you send the <a href="/contact/">contact form</a>, Cloudflare Turnstile
					checks the submission for automated abuse. Cloudflare receives your IP address
					and technical signals from your browser for that check. The form contents are
					then sent through Cloudflare Email Sending to an email inbox hosted by Google
					(Gmail). The site does not keep the message in a website database. Cloudflare
					keeps a preview of each sent message, including your name, email address,
					subject, and message, in the site owner's Email Sending activity log for about
					7 days, after which it is removed automatically. The copy in the Gmail inbox
					stays there until the site owner manually deletes it; there is no fixed
					retention schedule.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Hosting</h2>
				<p class="lede">
					This site is hosted on <strong>Cloudflare Pages</strong>. Like most web hosts,
					Cloudflare's infrastructure processes standard request data (such as IP
					address, user agent, and request timing) to serve pages and protect against
					abuse. We don't run analytics or tracking scripts of our own on top of this.
					See the <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Cloudflare Privacy Policy</a>.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Third-Party Services</h2>
				<p class="lede">
					This site loads or links to a small number of third-party services that may
					collect data independently under their own privacy policies:
				</p>
				<ul class="policy-list">
					<li>
						<strong>Cloudflare Turnstile and Email Sending</strong> — used to protect the
						contact form from automated abuse and deliver submitted messages. See the
						<a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer">Cloudflare Privacy Policy</a>.
					</li>
					<li>
						<strong>Google Fonts</strong> is used to load the site's typefaces (Bebas Neue,
						Barlow Condensed, Libre Franklin, and Roboto Slab). Google may log requests
						made to its font servers, including IP address. See the
						<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
					</li>
					<li>
						<strong>Google Gmail</strong> — the contact form's messages are delivered to
						an inbox hosted by Google. See the
						<a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy Policy</a>.
					</li>
					<li>
						<strong>Spotify</strong> — the homepage embeds a Spotify album player in a
						sandboxed frame. The frame is set to load lazily, so it loads as it nears
						your screen rather than when you click play. Loading it connects your
						browser to Spotify, whose privacy policy applies to the player. Other pages
						link to the album on Spotify. See the
						<a href="https://www.spotify.com/legal/privacy-policy/" target="_blank" rel="noopener noreferrer">Spotify Privacy Policy</a>.
					</li>
					<li>
						<strong>Apple Music</strong> — we link to the album on Apple Music. Apple's
						privacy policy applies if you follow that link. See the
						<a href="https://www.apple.com/legal/privacy/" target="_blank" rel="noopener noreferrer">Apple Privacy Policy</a>.
					</li>
				</ul>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Cookies</h2>
				<p class="lede">
					This site does not set advertising or analytics cookies. The embedded Spotify
					player is Spotify's service, and its cookies and storage are subject to
					Spotify's privacy policy above. Cloudflare may use strictly necessary storage while
					protecting the contact form. You can control or delete cookies through your
					browser settings.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>External Links</h2>
				<p class="lede">
					This site links to external platforms (Spotify, Apple Music, and others as
					they're added). We're not responsible for the privacy practices or content of
					those sites.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Changes to This Policy</h2>
				<p class="lede">
					We may update this policy as the site changes — for example, if new streaming
					or social platforms are added. Any changes will be reflected on this page with
					an updated date.
				</p>
			</section>

			<hr class="rule" />

			<section class="policy-block">
				<h2>Contact</h2>
				<p class="lede">
					For privacy-related questions, use the <a href="/contact/">contact form</a>. If
					the form is unavailable, the page displays
					<a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> as a fallback.
				</p>
			</section>
		</div>
	</div>
</Layout>

<style>
	.policy {
		display: flex;
		flex-direction: column;
	}

	.policy-block h2 {
		font-size: var(--text-h3);
		margin: 0 0 var(--space-3);
	}

	.policy .rule {
		margin: var(--space-6) 0;
	}

	.policy-list {
		margin: var(--space-4) 0 0;
		padding-left: 1.25em;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		color: var(--ink-2);
		font-size: var(--text-body-lg);
		line-height: var(--lh-body);
	}
</style>
