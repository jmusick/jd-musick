---
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import cover from "../assets/the-road-still-knows-cover.png";
import { ALBUM, ALBUM_RUNTIME, TRACK_COUNT, formatReleaseDate } from "../data/album";
import { ACTIVE_SOCIALS, SITE_GENRE_PHRASE, SITE_NAME, SITE_URL } from "../config/site";
import { albumEntity } from "../lib/structured-data";

const canonicalUrl = `${SITE_URL}/music/`;

const coverForSchema = await getImage({ src: cover, format: "webp", width: 1200 });
const structuredData = albumEntity(new URL(coverForSchema.src, SITE_URL).href);

const releaseDate = formatReleaseDate();
const title = `${ALBUM.title} — ${SITE_NAME} | Music`;
const description = `${ALBUM.title}, the debut ${SITE_GENRE_PHRASE} album by ${SITE_NAME}${releaseDate ? `, released ${releaseDate}` : ""}. Tracklist, runtime, and where to listen.`;
---

<Layout
	title={title}
	description={description}
	canonicalUrl={canonicalUrl}
	structuredData={structuredData}
	active="music"
>
	<div class="page">
		<p class="eyebrow">Music</p>
		<h1 style="margin-top: var(--space-3)">{ALBUM.title}</h1>

		<div class="release" style="margin-top: var(--space-7)">
			<div class="release-art">
				<Image src={cover} alt={`${ALBUM.title} album cover`} widths={[340, 680]} sizes="(max-width: 420px) calc(100vw - 32px), 340px" />
			</div>

			<div class="release-meta">
				<span class="badge">{ALBUM.status}</span>
				<p class="lede">{ALBUM.blurb}</p>
				<div class="meta-row">
					<span>{ALBUM.kind}</span>
					<span>{TRACK_COUNT} tracks</span>
					<span>{ALBUM_RUNTIME}</span>
					<span>
						{releaseDate ?? `${ALBUM.year} · date TBA`}
					</span>
				</div>

				{ACTIVE_SOCIALS.length > 0 ? (
					<div class="hero-cta">
						{ACTIVE_SOCIALS.map((s) => (
							<a class="btn btn-secondary" href={s.href} target="_blank" rel="noopener noreferrer">
								{s.label}
							</a>
						))}
					</div>
				) : (
					<p style="color: var(--ink-3)">
						Streaming links go live with the record.
					</p>
				)}
			</div>
		</div>

		<hr class="rule" />

		<section>
			<p class="eyebrow">Tracklist</p>
			<ol class="tracklist" style="margin-top: var(--space-5)">
				{ALBUM.tracks.map((track) => (
					<li class="track">
						<span class="track-n">{String(track.n).padStart(2, "0")}</span>
						<span>
							<span class="track-title">{track.title}</span>
							<span class="track-note">{track.note}</span>
						</span>
						<span class="track-time">{track.duration}</span>
					</li>
				))}
			</ol>
		</section>
	</div>
</Layout>

<style>
	.release-meta .badge {
		align-self: flex-start;
	}

	.track-title {
		font-family: var(--font-display);
		font-size: 1rem;
	}
</style>
